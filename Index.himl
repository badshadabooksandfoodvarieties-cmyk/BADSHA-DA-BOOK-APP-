<!-- SCRIPT -->

<script>

/* STOCK SYSTEM */

function buyProduct(stockId){

let stock =
document.getElementById(stockId);

let currentStock =
parseInt(stock.innerText);

if(currentStock > 0){

currentStock--;

stock.innerText =
currentStock;

if(currentStock == 0){

stock.innerText =
"Out of Stock";

stock.classList.add("out-stock");

}

alert("Order Successful!");

}

else{

alert("Product Out of Stock");

}

}

/* DELIVERY SYSTEM */

function checkDelivery(){

let distance =
parseFloat(
document.getElementById("distance").value
);

let result =
document.getElementById("deliveryResult");

if(isNaN(distance)){

result.innerHTML =
"Please Enter Distance";

result.className =
"error";

return;

}

if(distance <= 15){

let charge = 0;

if(distance > 5){

charge = distance * 10;

}

result.innerHTML =

"тЬЕ Delivery Available <br><br>" +

"ЁЯУж Delivery Charge : тВ╣" +
charge;

result.className =
"success";

}

else{

result.innerHTML =

"тЭМ Sorry! Delivery Not Available Above 15KM";

result.className =
"error";

}

}

</script>

