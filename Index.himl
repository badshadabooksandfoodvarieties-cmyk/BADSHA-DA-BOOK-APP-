<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>BADSHA DA BOOKS AND FOOD VARITIES</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f4f4f4;
}

/* HEADER */

header{
background:#700018;
padding:15px 5%;
display:flex;
justify-content:space-between;
align-items:center;
flex-wrap:wrap;
}

.logo{
color:white;
font-size:28px;
font-weight:bold;
}

nav a{
color:white;
text-decoration:none;
margin:10px;
font-weight:bold;
}

/* HERO */

.hero{
background:
linear-gradient(rgba(0,0,0,.6),rgba(0,0,0,.6)),
url('https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?q=80&w=1400');

background-size:cover;
background-position:center;

padding:100px 20px;
text-align:center;
color:white;
}

.hero h1{
font-size:55px;
margin-bottom:20px;
}

.hero p{
font-size:22px;
margin-bottom:30px;
}

.hero button{
padding:15px 35px;
font-size:18px;
background:#ffd54f;
border:none;
border-radius:40px;
cursor:pointer;
font-weight:bold;
}

/* SECTION */

.section{
padding:70px 5%;
}

.title{
text-align:center;
font-size:40px;
margin-bottom:50px;
color:#700018;
}

/* PRODUCTS */

.products{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:30px;
}

.card{
background:white;
border-radius:20px;
overflow:hidden;
box-shadow:0 5px 15px rgba(0,0,0,.1);
transition:.3s;
}

.card:hover{
transform:translateY(-8px);
}

.card img{
width:100%;
height:220px;
object-fit:cover;
}

.card-content{
padding:20px;
}

.card-content h3{
margin-bottom:10px;
font-size:25px;
}

.card-content p{
margin-bottom:15px;
color:#555;
line-height:1.6;
}

/* STOCK */

.stock{
font-size:18px;
font-weight:bold;
margin-bottom:20px;
color:green;
}

.out-stock{
color:red;
}

/* BUTTON */

.card-content button{
padding:12px 25px;
background:#700018;
color:white;
border:none;
border-radius:30px;
font-size:16px;
cursor:pointer;
}

/* DELIVERY BOX */

.delivery-box{
background:white;
padding:40px;
border-radius:20px;
box-shadow:0 5px 15px rgba(0,0,0,.1);
text-align:center;
margin-top:50px;
}

.delivery-box h3{
font-size:35px;
margin-bottom:20px;
color:#700018;
}

.delivery-box p{
font-size:18px;
margin-bottom:20px;
}

.delivery-box input{
width:250px;
padding:12px;
font-size:18px;
border:2px solid #700018;
border-radius:10px;
outline:none;
}

.delivery-box button{
padding:12px 25px;
background:#700018;
color:white;
border:none;
border-radius:30px;
font-size:17px;
cursor:pointer;
margin-top:15px;
}

#deliveryResult{
margin-top:25px;
font-size:20px;
font-weight:bold;
}

.success{
color:green;
}

.error{
color:red;
}

/* FEATURES */

.features{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:25px;
}

.feature-box{
background:white;
padding:35px 20px;
border-radius:20px;
text-align:center;
box-shadow:0 5px 15px rgba(0,0,0,.08);
}

.feature-box i{
font-size:45px;
color:#700018;
margin-bottom:20px;
}

.feature-box h4{
margin-bottom:15px;
font-size:24px;
}

/* CONTACT */

.contact{
background:#700018;
color:white;
padding:60px 20px;
text-align:center;
}

.contact h2{
font-size:40px;
margin-bottom:20px;
}

.contact p{
font-size:20px;
margin:10px 0;
}

/* FOOTER */

footer{
background:#30000a;
color:white;
text-align:center;
padding:25px;
}

/* MOBILE */

@media(max-width:768px){

.hero h1{
font-size:38px;
}

.hero p{
font-size:18px;
}

.title{
font-size:32px;
}

}

</style>
</head>

